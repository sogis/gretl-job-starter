#!/usr/bin/env bash
set -e
output=
previous=
for arg; do
  if [[ "$previous" == -o ]]; then output=$arg; fi
  previous=$arg
done
if [[ "${output##*/}" != jobstarter ]]; then exec /usr/bin/gcc "$@"; fi

log="${output%/*}/native-link.log"
map="${output%/*}/native-link.map"
{
  printf '%q ' /usr/bin/gcc "$@"
  printf '\n'
  /usr/bin/gcc -### "$@"
  for startup in crt1.o Scrt1.o crti.o crtbeginS.o crtendS.o crtn.o; do
    path=$(/usr/bin/gcc -print-file-name="$startup")
    if [[ -f "$path" ]]; then
      printf '\nStartup input %s\n' "$path"
      readelf -n "$path"
    fi
  done
  for arg; do
    if [[ "$arg" == *.o && -f "$arg" ]]; then
      printf '\nProduced object %s\n' "$arg"
      readelf -n "$arg"
    elif [[ "$arg" == *.a && -f "$arg" ]]; then
      readelf -n "$arg" | awk '/^File:/{file=$0} /x86 ISA needed.*x86-64-v[34]/{print file; print}'
    fi
  done
} >"$log" 2>&1
/usr/bin/gcc "$@" "-Wl,-Map=$map"
{
  readelf -n "$output"
  rg -A 4 -B 1 'property|\.note.gnu.property' "$map" | head -140
  /usr/bin/gcc -dumpfullversion
  ld --version | head -1
} >>"$log" 2>&1
